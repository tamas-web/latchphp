{
    "name": "tamas-web/latchphp",
    "description": "LatchPHP — a lightweight PHP 8 MVC framework with a first-class plugin & hook system.",
    "homepage": "https://github.com/tamas-web/latchphp",
    "license": "MIT",
    "authors": [
        {
            "name": "Mujnoi Tamas",
            "homepage": "https://github.com/tamas-web"
        }
    ],
    "support": {
        "issues": "https://github.com/tamas-web/latchphp/issues",
        "source": "https://github.com/tamas-web/latchphp"
    },
    "require": {
        "phpmailer/phpmailer": "^6.7",
        "cocur/slugify": "^4.3",
        "nicolab/php-ftp-client": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "autoload": {
		"psr-4": {
            "App\\" : "app/",
            "Plugins\\" : "plugins/"
        },
		"files": [
			"helpers/env.php",
			"helpers/app.php",
			"helpers/filters.php",
			"helpers/nonce.php"
		]
    }
}
