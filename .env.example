# Copy to .env and fill in. Real environment variables override these.
# .env is gitignored; never commit real secrets.

# development | production  (default: production)
APP_ENV=development

# Brand name shown in the UI wordmark, emails and page titles
APP_NAME=LatchPHP

# Canonical base URL (used for links/emails; falls back to the request host when unset)
APP_URL=
# Locale / timezone / UI language
APP_TIMEZONE=Europe/Bucharest
APP_LOCALE=ro_RO
APP_LANG=en

# Cookies / session (domain falls back to the request host when empty)
COOKIE_PREFIX=
COOKIE_DOMAIN=
SESSION_NAME=SID

# Nonce time-to-live, in seconds
NONCE_TTL=3600

# Uploads (dir falls back to <app>/uploads when empty; image max in px)
UPLOAD_DIR=
UPLOAD_IMAGE_MAX_WIDTH=1024
UPLOAD_IMAGE_MAX_HEIGHT=1024

# E-mail subject decoration (appended after the per-message subject)
EMAIL_SUBJECT_SEPARATOR=
EMAIL_SUBJECT_SUFFIX=

# --- Database (also consumed by docker-compose) ---
DB_HOST=database
DB_NAME=starter
DB_USER=starter
DB_PASS=change-me
DB_ROOT_PASS=change-me-root
# Optional separate admin connection (defaults to the above when unset)
# DB_ADMIN_HOST=
# DB_ADMIN_NAME=
# DB_ADMIN_USER=
# DB_ADMIN_PASS=

# --- Auth secrets (generate 32+ random chars each) ---
APP_SALT_FIRST=change-me-salt-1
APP_SALT_SECOND=change-me-salt-2
APP_SALT_THIRD=change-me-salt-3
APP_SALT_FOURTH=change-me-salt-4
NONCE_SALT=change-me-nonce-salt

# --- SMTP ---
SMTP_HOST=localhost
SMTP_PORT=465
# Transport encryption: ssl | tls | none
SMTP_ENCRYPTION=ssl
# Authenticate with SMTP_USER / SMTP_PASS (set false for open local relays)
SMTP_AUTH=true
# Verbose SMTP server dialogue in logs (dev only)
SMTP_DEBUG=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
# Sender name; falls back to APP_NAME when unset
SMTP_FROM_NAME=
SMTP_BCC=

# --- FTP backup (app/Backup/Backup.php) ---
FTP_HOST=
FTP_USER=
FTP_PASS=

# --- Xdebug (docker) ---
XDEBUG_MODE=debug
